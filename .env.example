# fd-legal-search-mcp — 全部配置走环境变量（无配置文件）。
#
# 生产取值位置：INFRA-NOTES.md（PG/Qdrant/RustFS 坐标）、cheap fd-mcp-env secret
# （FDBIZ_* 同源值）、business-mcp .env（FDBIZ_DOMAIN_PG_URL）。此处不落任何口令。

# law_db（PostgreSQL；Windows 数据机 Tailnet 100.64.0.5:5432）
FDLEX_LAW_DATABASE_URL=postgresql://postgres:***@100.64.0.5:5432/law_db

# wenshu_db（同机同实例，不同库）
FDLEX_WENSHU_DATABASE_URL=postgresql://postgres:***@100.64.0.5:5432/wenshu_db

# Qdrant（law-rag / cheap；law_chunks_v2 为 1024 维 cosine，law_id 负载是字符串）
FDLEX_QDRANT_URL=http://100.64.0.9:6333
FDLEX_QDRANT_COLLECTION=law_chunks_v2
FDLEX_QDRANT_API_KEY=

# RustFS（S3 兼容；wenshu 正文 zstd 块，默认桶名 wenshu）
FDLEX_RUSTFS_ENDPOINT=http://172.16.11.249:9000
FDLEX_RUSTFS_BUCKET=wenshu
FDLEX_RUSTFS_ACCESS_KEY=
FDLEX_RUSTFS_SECRET_KEY=

# Embedding（查询向量必须与建库同模型、同维度）
FDLEX_EMBED_BACKEND=api
FDLEX_EMBED_API_URL=
FDLEX_EMBED_API_KEY=
FDLEX_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
FDLEX_EMBED_DIM=1024